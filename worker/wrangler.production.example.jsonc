{
  "name": "baller-submissions-production",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY",
      "RATE_LIMIT_SECRET",
      "REQUEST_HASH_SECRET",
      "ALERT_POLL_SECRET",
      "GOOGLE_SERVICE_ACCOUNT_EMAIL",
      "GOOGLE_PRIVATE_KEY",
      "GOOGLE_SHEETS_SPREADSHEET_ID"
    ]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://ballerexpress.com",
    "SUBMISSIONS_ENABLED": "false",
    "RATE_LIMIT_WINDOW_SECONDS": "600",
    "RATE_LIMIT_MAX_ATTEMPTS": "20",
    "RATE_LIMIT_RETENTION_SECONDS": "86400",
    "DEDUPE_WINDOW_SECONDS": "600",
    "PENDING_STALE_SECONDS": "120"
  },
  "d1_databases": [
    {
      "binding": "SUBMISSIONS_DB",
      "database_name": "baller-submissions-production",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "preview_urls": false
}
